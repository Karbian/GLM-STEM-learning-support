rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function student(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.matches('^[^@]+@glm\\.edu\\.co$');
    }

    function validProgress(exerciseId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'studentName', 'studentEmail', 'exerciseId', 'level', 'topic', 'title',
          'engine', 'status', 'score', 'passed', 'feedback', 'reflection', 'code',
          'output', 'testInputs', 'expectedChecks', 'attemptNumber', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'studentName', 'studentEmail', 'exerciseId', 'level', 'topic', 'title',
          'engine', 'status', 'score', 'passed', 'feedback', 'reflection', 'code',
          'output', 'testInputs', 'expectedChecks', 'attemptNumber', 'updatedAt'
        ])
        && data.exerciseId == exerciseId
        && exerciseId.matches('^[A-Z0-9-]{1,40}$')
        && data.studentEmail == request.auth.token.email
        && data.studentName is string && data.studentName.size() >= 3 && data.studentName.size() <= 120
        && data.level is string && data.level.size() <= 40
        && data.topic is string && data.topic.size() <= 80
        && data.title is string && data.title.size() <= 160
        && data.engine in ['brython', 'pyodide']
        && data.status in ['In progress', 'Submitted', 'Completed', 'Needs revision', 'Mastery evidence']
        && data.score is int && data.score >= 0 && data.score <= 100
        && data.passed is bool
        && data.feedback is string && data.feedback.size() <= 1000
        && data.reflection is string && data.reflection.size() <= 1500
        && data.code is string && data.code.size() <= 50000
        && data.output is string && data.output.size() <= 20000
        && data.testInputs is string && data.testInputs.size() <= 500
        && data.expectedChecks is string && data.expectedChecks.size() <= 500
        && data.attemptNumber is int && data.attemptNumber >= 1
        && data.updatedAt == request.time;
    }

    match /students/{uid}/progress/{exerciseId} {
      allow get, list: if student(uid);
      allow create: if student(uid) && validProgress(exerciseId)
        && request.resource.data.attemptNumber == 1;
      allow update: if student(uid) && validProgress(exerciseId)
        && request.resource.data.attemptNumber == resource.data.attemptNumber + 1;
      allow delete: if false;
    }

    // Deny all other reads and writes, including student lists and teacher access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
